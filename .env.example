# ===== Cyber Universe 环境变量模板 =====
# 复制为 .env 后填写。禁止提交真实密钥。

# ---- 后端 (读取前缀 CYBER_) ----
# 本地开发使用 SQLite；生产部署切换为 PostgreSQL，例如:
# CYBER_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cyber_universe
CYBER_DATABASE_URL=sqlite:///./cyber_universe.db
# 生产环境必须使用强随机密钥，例如: openssl rand -hex 32
CYBER_SECRET_KEY=change-me-to-a-long-random-string
CYBER_ENV=development
CYBER_CORS_ORIGINS=["http://localhost:5173"]
# API 密钥加密密钥（Fernet，32 字节 base64；生产必须替换）
CYBER_API_KEY_ENCRYPTION_KEY=

# ---- 前端 (Vite, 读取前缀 VITE_) ----
VITE_API_URL=/api
VITE_WS_URL=/ws
